# RepoSweep — shipped default thresholds (the canonical opinion).
#
# This is the lowest-precedence layer of the threshold config. Override
# selectively in a repo-root reposweep.env (partial — name only the keys you
# change), or per-run via an environment variable of the same name.
# See CONTEXT.md → "Threshold config" and "Resolved thresholds".
#
# Every value is a plain scalar number. There is no schema beyond "is it a
# number"; unknown keys source harmlessly.

STALE_DAYS=60              # issue general + PR stale window (idle days)
NEEDS_INFO_DAYS=7          # needs-info fast-stale window (idle days)
PR_LONG_LIVED_DAYS=90      # PR long-lived flag (age days since creation)
SIZE_SMALL_LINES=30        # Prow small: <30 changed lines AND <=3 files
SIZE_SMALL_FILES=3
SIZE_LARGE_LINES=500       # Prow large: >=500 changed lines OR >=10 files
SIZE_LARGE_FILES=10
DEDUP_MIN_SHARED_TOKENS=2  # dedup nomination guard: min significant shared title tokens
DEDUP_MAX_PARTNERS=5       # per-item partner cap (drop over-generic titles)
