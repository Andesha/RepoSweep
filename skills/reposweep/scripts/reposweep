#!/bin/sh
# Start a read-only sweep. The driving agent completes judgment via review.sh.
set -eu
HERE=$(CDPATH='' cd "$(dirname "$0")" && pwd)
. "$HERE/lib.sh"
case "${1:-}" in
  -h|--help)
    printf 'Usage: sh %s [TARGET_REPO_DIRECTORY]\n\nFetch all open GitHub issues and PRs, classify, and render a preliminary report.\nRun inside an agent with SKILL.md to complete judgment and duplicate review.\nOnly local .reposweep/ artifacts are written.\n' "$0"
    exit 0;;
esac
[ "$#" -le 1 ] || { echo 'reposweep: expected at most one target directory' >&2; exit 1; }
for tool in gh jq git; do command -v "$tool" >/dev/null || { echo "reposweep: missing $tool" >&2; exit 1; }; done
ROOT=$(git -C "${1:-.}" rev-parse --show-toplevel)
REPO=$(cd "$ROOT" && gh repo view --json nameWithOwner -q .nameWithOwner)
config=$(resolve_config "$HERE/.." "$ROOT")
labels=$(resolve_labels "$ROOT/docs/agents/triage-labels.md")
SA=$(swept_at)
RID=$(printf '%s' "$SA" | tr -d ':-')
RUNS="$ROOT/.reposweep/runs"
mkdir -p "$RUNS"
RUN="$RUNS/$RID"
i=0
while [ -e "$RUN" ]; do i=$((i + 1)); RUN="$RUNS/$RID-$i"; done
mkdir "$RUN"
printf '%s\n' "$config" | write_meta "$RUN" "$SA" "$REPO"
jq --argjson labels "$labels" '.labels = $labels' "$RUN/meta.json" > "$RUN/meta.tmp"
mv "$RUN/meta.tmp" "$RUN/meta.json"
printf 'reposweep: fetching %s into %s\n' "$REPO" "$RUN" >&2
sh "$HERE/fetch-normalize.sh" "$RUN" >/dev/null
sh "$HERE/classify.sh" "$RUN" >/dev/null
sh "$HERE/report.sh" "$RUN" >/dev/null
# Publish latest only after the mechanical run succeeds.
if [ -e "$RUNS/latest" ] && [ ! -L "$RUNS/latest" ]; then
  echo "reposweep: refusing to replace non-symlink $RUNS/latest" >&2; exit 1
fi
rm -f "$RUNS/latest"
ln -s "$(basename "$RUN")" "$RUNS/latest"
jq -rs --arg run "$RUN" '"reposweep: \(length) items; \([.[] | select(.needs_agent)] | length) judgments and \([.[].duplicate_candidates[] | select(.confirmed == null)] | length) duplicate pairs pending.\nReport: \($run)/report.html\nNo tracker changes made."' "$RUN/verdicts.jsonl" >&2
printf '\nContinue with: sh %s/review.sh next %s\n\n' "$HERE" "$RUN" >&2
sh "$HERE/report.sh" --publish "$RUN" "$ROOT" >&2
printf '%s\n' "$RUN"
